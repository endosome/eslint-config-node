{
  "name": "@endosome/eslint-config-node",
  "version": "1.0.0",
  "description": "Shared ESLint 10 flat config for Node.js and TypeScript projects",
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslint-config",
    "flat-config",
    "typescript",
    "node"
  ],
  "license": "MIT",
  "author": "endosome",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endosome/eslint-config-node.git"
  },
  "bugs": "https://github.com/endosome/eslint-config-node/issues",
  "homepage": "https://github.com/endosome/eslint-config-node#readme",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "rules",
    "custom_words.txt",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test test/*.test.js"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": ">=4.8.4 <6.1.0"
  },
  "dependencies": {
    "@cspell/eslint-plugin": "10.3.6",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-html": "8.2.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-sort-destructure-keys": "3.0.0",
    "eslint-plugin-tsdoc": "0.5.4",
    "eslint-plugin-unicorn": "77.0.0",
    "globals": "17.13.0",
    "typescript-eslint": "8.71.1"
  },
  "devDependencies": {
    "eslint": "10.12.0",
    "typescript": "6.0.3"
  }
}
